# ---------- Firebase (web config: public, safe in the browser) ----------
# Firebase console > Project settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (SERVER ONLY, never expose to the browser) ----------
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the quotes and the \n escapes exactly as in the downloaded JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- File storage (Supabase Storage) ----------
# Supabase > Project settings > API. The service_role key is SERVER ONLY (it bypasses
# Supabase row-level security); never expose it. The private bucket is created
# automatically on first upload. Without these, documents and photos are unavailable
# but the rest of the app works.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=care-circle-documents

# ---------- Email (Brevo) ----------
# Brevo > SMTP & API > API Keys. EMAIL_FROM_ADDRESS must be a verified sender in Brevo
# (Senders, Domains & Dedicated IPs). Without BREVO_API_KEY the app still works:
# emails are recorded as "skipped".
BREVO_API_KEY=
EMAIL_FROM_NAME="Care Circle"
EMAIL_FROM_ADDRESS=

# ---------- App ----------
# Public URL of the deployed app. Used in email links.
APP_URL=http://localhost:3000
# Require email verification before the app is usable (recommended: true).
REQUIRE_EMAIL_VERIFICATION=true
# Shared secret for the scheduler that calls /api/jobs/tick (>= 16 chars).
#   openssl rand -base64 32
CRON_SECRET=

# --- Phase 2: Gemini (server-only; never prefix with NEXT_PUBLIC_) ---
GEMINI_API_KEY=
# Leave the model vars EMPTY to auto-pick from models.list (stable Flash first).
# Or set an ordered fallback list: GEMINI_VISION_MODEL=model-a,model-b
GEMINI_TEXT_MODEL=
GEMINI_VISION_MODEL=
GEMINI_LIVE_MODEL=
# Optional per-user daily quotas and request timeout
AI_DAILY_PRESCRIPTION_SCANS=20
GEMINI_TIMEOUT_MS=55000
GEMINI_ATTEMPT_TIMEOUT_MS=25000

# --- Optional extra AI providers (OpenAI-compatible gateways) ---
# Providers are tried in this order; only ones with a key (and models) are used.
AI_PROVIDER=gemini,openrouter,opencode
OPENROUTER_API_KEY=
# Ordered fallback lists, e.g. vendor/model-a,vendor/model-b. Must support tools + JSON output (+ images for vision).
OPENROUTER_TEXT_MODEL=
OPENROUTER_VISION_MODEL=
OPENCODE_API_KEY=
OPENCODE_TEXT_MODEL=
OPENCODE_VISION_MODEL=
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Public demo mode: a "Try the demo" button with made-up family data and no sign-up.
# Uses real Firebase accounts that have no password. Leave false for real use.
DEMO_MODE=false

# Optional: set to "rest" if Firestore calls stall on your network (local development). Leave unset on Vercel.
# FIRESTORE_TRANSPORT=rest
